# Kredensial & data tempatan Bayarcash — jangan commit.
# Abaikan SEGALA yang ada dalam api/data/ kecuali fail struktur, supaya
# fail data baharu pada masa depan tidak terlepas masuk git secara tidak
# sengaja. Fail ini mengandungi API Secret Key dan rekod order pelanggan.
api/config.php
api/data/*
!api/data/.gitkeep
!api/data/.htaccess
